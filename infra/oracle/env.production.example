# Copy to /home/ubuntu/FinView/.env.production and fill in real values.
# chmod 600 .env.production after editing.

FINVIEW_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
FINVIEW_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
FINVIEW_AUTH_SECRET=MUST_MATCH_FRONTEND_AUTH_SECRET
FINVIEW_FRONTEND_URL=https://finview.vercel.app

# Optional — only if used
FINVIEW_STRIPE_SECRET_KEY=
FINVIEW_ANTHROPIC_API_KEY=
